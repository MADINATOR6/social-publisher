{
  "name": "social-publisher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c gray,yellow,cyan \"tsx watch server/index.ts\" \"tsx watch server/worker.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "start": "concurrently -k -n api,worker \"tsx server/index.ts\" \"tsx server/worker.ts\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}