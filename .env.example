# ---- Required ----
# Password for signing in to this app. Use something long.
APP_PASSWORD=change-me-to-a-long-passphrase
# Random secrets. Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Where the browser opens the app. OAuth redirect URIs are built from this:
#   {APP_URL}/api/oauth/tiktok/callback   {APP_URL}/api/oauth/instagram/callback   {APP_URL}/api/oauth/youtube/callback
APP_URL=http://localhost:5173
API_PORT=8787
DATA_DIR=./data

# Demo mode adds clearly labelled demo accounts with simulated publishing. Nothing is posted.
DEMO_MODE=false
# Skip the password screen for local owner testing only. Keep false otherwise.
NO_SIGN_IN=false

# Public HTTPS address that reaches this app (can also be set in the app) (for example a Cloudflare Tunnel or ngrok URL).
# Instagram downloads the video from here, so Instagram publishing is unavailable without it.
PUBLIC_BASE_URL=

# Delete uploaded videos this many hours after every destination has finished.
MEDIA_RETENTION_HOURS=72
MAX_UPLOAD_MB=4096

# ---- Platform keys ----
# Easiest: leave these empty and paste the keys in the app (Connected accounts > Set up).
# Keys saved in the app are encrypted and take priority over the values below.

# ---- TikTok (developers.tiktok.com: Login Kit + Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Leave false. TikTok only allows public Direct Post for audited apps, and personal tools are not eligible.
TIKTOK_DIRECT_POST_ENABLED=false

# ---- Instagram (developers.facebook.com: Instagram API with Instagram Login) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# ---- YouTube (console.cloud.google.com: YouTube Data API v3, OAuth client "Web application") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
